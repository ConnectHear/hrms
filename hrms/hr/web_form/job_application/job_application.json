 "client_script": "(function () {\n  var roleTitle = null, fetched = false;\n  function getCode() {\n    try { return new URLSearchParams(window.location.search).get('job_title'); } catch (e) { return null; }\n  }\n  function hideDefaultTitle() {\n    document.querySelectorAll('h1, h2, h3, .title, .web-form-title, .page-title').forEach(function (el) {\n      if ((el.textContent || '').trim() === 'Job Application') {\n        el.style.display = 'none';\n        var p = el.parentElement;            // collapse the container so it leaves no gap\n        if (p) { p.style.margin = '0'; p.style.padding = '0'; p.style.minHeight = '0'; p.style.border = 'none'; }\n      }\n    });\n  }\n  function fillRole() {\n    if (!roleTitle) return;\n    var el = document.getElementById('ch-role-title');\n    if (el && el.textContent.trim() !== roleTitle) { el.textContent = roleTitle; }\n    document.title = roleTitle + ' \\u2014 ConnectHear';\n  }\n  function tidy() {\n    document.querySelectorAll('.indicator-pill, .web-form-actions .indicator').forEach(function (el) { el.style.display = 'none'; });\n    var jt = document.querySelector('[data-fieldname=\\\"job_title\\\"]');\n    if (jt) { jt.style.display = 'none'; }\n  }\n  function tick() {\n    hideDefaultTitle(); tidy();\n    var code = getCode();\n    if (code && !fetched && window.frappe && frappe.call) {\n      fetched = true;\n      frappe.call({ method: 'hr_automations.recruitment_web.job_opening_title', args: { opening: code } })\n        .then(function (r) { if (r && r.message) { roleTitle = r.message; fillRole(); } });\n    }\n    fillRole();\n  }\n  var n = 0, iv = setInterval(function () { tick(); if (++n > 30) clearInterval(iv); }, 200);\n})();",
